# =================================================================
# HELIOZ AI - ENVIRONMENT CONFIGURATION
# =================================================================

# -----------------------------------------------------------------
# 1. META API (Replaces Lightning AI)
# -----------------------------------------------------------------
# Enter your Meta API Key (from Meta Model API, Llama API, etc.)
META_API_KEY=your_meta_api_key_here

# Meta API endpoint (OpenAI-compatible endpoint)
# Default official endpoint: https://api.meta.ai/v1/chat/completions
META_API_URL=https://api.meta.ai/v1/chat/completions

# Model ID to use for curriculum synthesis, video evaluation & quizzes
# Examples: llama-3.3-70b-instruct, Llama-3.1-70B-Instruct, llama-3.2-11b-vision-instruct
META_MODEL=llama-3.3-70b-instruct

# -----------------------------------------------------------------
# 2. RAPIDAPI (YouTube Transcripts & Captions)
# -----------------------------------------------------------------
# API Key from RapidAPI (used by 'youtube-captions-transcript-subtitles-video-combiner')
# Get it at: https://rapidapi.com/
RAPIDAPI_KEY=your_rapidapi_key_here

# -----------------------------------------------------------------
# 3. YOUTUBE DATA API V3 (Video Search)
# -----------------------------------------------------------------
# Google Cloud Console YouTube Data API v3 Key for finding candidate lectures
YOUTUBE_API_KEY=your_youtube_api_key_here

# -----------------------------------------------------------------
# 4. FIREBASE ADMIN PERSISTENCE (Optional)
# -----------------------------------------------------------------
# Path to your Firebase service account private key file
# If not present or unconfigured, Helioz automatically falls back to local workspace storage
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# -----------------------------------------------------------------
# 5. SERVER CONFIGURATION
# -----------------------------------------------------------------
PORT=5000
